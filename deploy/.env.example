# Copy to .env (same folder) and fill in. Never commit .env.

# Domains (DNS at Cloudflare)
API_DOMAIN=api.example.com
WEB_DOMAIN=example.com
ACME_EMAIL=you@example.com            # Let's Encrypt notices

# Database (generate: openssl rand -base64 32 | tr -d '/+=')
POSTGRES_DB=arayanibul
POSTGRES_USER=arayanibul
POSTGRES_PASSWORD=

# JWT signing secret, >= 32 chars (generate: openssl rand -base64 48)
JWT_SECRET=

# Admin panel access (comma separated e-mails)
ADMIN_EMAILS=you@example.com

# Social login (Google Cloud Console → Credentials; Meta for Developers)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_BUNDLE_ID=com.arayanibul.app

# E-mail (SMTP from Brevo/Resend etc.) — password reset and moderation mails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Arayanibul

# Off-site backups (optional): an rclone remote such as "r2:arayanibul-backups"
RCLONE_REMOTE=

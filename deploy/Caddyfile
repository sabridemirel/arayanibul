# HTTPS reverse proxy for the API (certificates are issued and renewed automatically).
{
	email {$ACME_EMAIL}
	servers {
		# Requests that come through Cloudflare carry the visitor IP in CF-Connecting-IP.
		# Only trust it when the request really comes from Cloudflare (ranges from
		# https://www.cloudflare.com/ips/ — check occasionally for changes).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:5000 {
		# Pass exactly one, already-verified client IP to the API (it trusts this proxy only).
		header_up X-Forwarded-For {client_ip}
	}
}

# Web app (static SPA built with VITE_API_URL=https://{$API_DOMAIN}/api)
{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
